{
	"name": "@terra-symposium/scraping-docs",
	"private": true,
	"version": "0.1.0",
	"description": "Docs and quality tooling for Terra Symposium Scraping",
	"packageManager": "pnpm@10.30.3",
	"engines": {
		"node": ">=24.12.0"
	},
	"docs": {
		"title": "Terra Symposium Scraping",
		"description": "Guides and API reference for the shared Terra scraping workflows.",
		"host": "127.0.0.1",
		"port": 2060,
		"out": "dist/docs"
	},
	"scripts": {
		"docs": "docs dev --host 127.0.0.1 --port 2060",
		"build": "docs build --out dist/docs",
		"quality": "cd .. && ./config/node_modules/.bin/terra-quality quality --all"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@terra-symposium/docs": "^0.4.3",
		"@terra-symposium/standards-quality": "^2.1.3",
		"eslint": "^10.13.0",
		"knip": "^6.44.1",
		"prettier": "^3.9.10",
		"typescript-eslint": "8.71.2",
		"globals": "^17.13.0"
	}
}
