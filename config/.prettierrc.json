{
  "arrowParens": "avoid",
  "jsxSingleQuote": true,
  "printWidth": 200,
  "proseWrap": "never",
  "singleQuote": true,
  "useTabs": true,
  "overrides": [
    {
      "files": [
        "**/*.md",
        "**/*.mdx"
      ],
      "options": {
        "parser": "mdx",
        "objectWrap": "collapse"
      }
    }
  ]
}
